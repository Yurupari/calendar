# ==============================================================================
# PostgreSQL Configurations
# ==============================================================================
POSTGRES_DB=calendar
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==============================================================================
# PostgreSQL Exporter Configurations
# ==============================================================================
# Combines the variables above dynamically into a connection URI
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# ==============================================================================
# Grafana Configurations
# ==============================================================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_SERVER_ROOT_URL=http://localhost:3000